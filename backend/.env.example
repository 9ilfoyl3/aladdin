# ============================================================
# Artoo 后端配置示例 —— 本地开发用
#
# 适用：make dev / 手动用 uvicorn 起后端（工作目录在 backend/，
#       pydantic 读取本文件同级的 .env）。
# 容器部署不读这里 —— 走根目录 .env.example（连接串由 compose 注入）。
#
# 复制为 backend/.env 后填写。注释项为内置默认值，需要时取消注释覆盖。
# ============================================================

# ===== 基础设施（本地直连 localhost；中间件由 make infra 启动）=====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artoo
MILVUS_HOST=localhost
MILVUS_PORT=19530
REDIS_URL=redis://localhost:6379/0

# ===== 对象存储 MinIO（知识库源文件权威存储；复用 Milvus 的 MinIO，独立 bucket）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=aladdin-documents
# 启动期对账孤儿对象的宽限期（秒）：仅删 last_modified 早于 now-该值 的无 DB 记录对象，
# 避免误删正在上传/建索引中的新对象。默认 3600（1 小时）。
MINIO_ORPHAN_GRACE_SECONDS=3600

# ===== 认证（必填，缺失则服务启动失败 fail-fast）=====
# JWT 签名密钥（HS256）。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# 初始超级管理员（首次启动自动创建，强制首次登录改密）
SUPER_ADMIN_USERNAME=root
SUPER_ADMIN_PASSWORD=ChangeMe#2024
# 注册模式：invite_only（默认，仅管理员/邀请建号）| self_serve（开放自助注册）
REGISTRATION_MODE=invite_only
# 超管业务内容可见边界：false（默认）= 超管不可查看业务内容正文
CONTENT_VIEW_BOUNDARY_OPEN=false

# ===== LLM（也可启动后在前端「模型管理」配置）=====
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ===== Embedding 远程服务（填到 /v1，也可在前端配置）=====
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
# 是否启用 Sparse 向量（需服务支持 /embed_sparse 端点）
EMBED_SPARSE_ENABLED=true

# ===== Rerank 远程服务（也可在前端配置）=====
RERANK_BASE_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# ===== 其余配置（OCR / 切片 / Agent）均有内置默认值 =====
# 需要调优时参考 backend/app/config.py，追加同名大写变量，例如：
# OCR_PROVIDER=external_api
# OCR_EXTERNAL_API_URL=http://your-ocr:8909/parse
# AGENT_MAX_ITERATIONS=10

# ============================================================
# 性能调优（按机器能力调整；不配则用下方默认值，本地默认偏保守）
# ============================================================
# 数据库连接池（每进程）：单进程上限 = POOL_SIZE + MAX_OVERFLOW
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 线程池（文档解析/切片、pymilvus 同步检索、bcrypt 等）。0 = Python 默认 min(32, CPU+4)
THREAD_POOL_MAX_WORKERS=0
# Worker 文档处理并发（本地单机建议小一些）
PIPELINE_MAX_CONCURRENT=4
PIPELINE_EMBED_CONCURRENCY=6
PIPELINE_EMBED_PER_DOC_CONCURRENCY=2
PIPELINE_EMBED_BATCH_SIZE=32
PIPELINE_EMBED_MAX_CONNECTIONS=20
PIPELINE_OCR_CONCURRENCY=4
PIPELINE_SLOW_LANE_MIN_MB=10
PIPELINE_SLOW_MAX_CONCURRENT=1
