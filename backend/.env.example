# ============================================================
# Artoo 配置文件示例
# 复制为 .env 后按需修改，注释项使用默认值即可
# ============================================================

# ===== 基础设施 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artoo
MILVUS_HOST=localhost
MILVUS_PORT=19530
REDIS_URL=redis://localhost:6379/0

# ===== Embedding 远程服务 =====
# 填服务地址到 /v1，系统自动拼接 /embeddings 和 /embed_sparse
# 也可启动后通过前端「Embedding & Rerank 配置」页面添加
# 前端 timeout 设为 0 = 不超时（推荐，避免大文件入库超时）
EMBED_BASE_URL=http://10.30.1.6:7997/v1
EMBED_MODEL=models/bge-m3
EMBED_API_KEY=
EMBED_SPARSE_ENABLED=false

# ===== Rerank 远程服务 =====
RERANK_BASE_URL=http://10.30.1.6:7998/v1
RERANK_MODEL=models/bge-reranker-v2-m3
RERANK_API_KEY=

# ===== LLM =====
# 也可启动后在前端"模型管理"页面配置
LLM_PROVIDER=vllm
LLM_BASE_URL=http://your-llm-server/v1
LLM_MODEL=your-model
LLM_API_KEY=

# ===== Pipeline Worker =====
# 通常使用默认值即可，仅在需要调优时取消注释
#
# Worker 同时处理的文档数（默认 2）
# GPU 推荐 3，CPU 推荐 1-2
# PIPELINE_MAX_CONCURRENT=2
#
# 每个文档的 Embedding 并发请求数（默认 4）
# GPU 推荐 8，CPU 推荐 2-4
# PIPELINE_EMBED_CONCURRENCY=4
#
# 每次请求发多少条文本给 Embedding 服务（默认 32）
# 建议和 embedding-rerank-server 的 max_batch_size 保持一致
# GPU 推荐 64，CPU 推荐 32
PIPELINE_EMBED_BATCH_SIZE=32
#
# httpx 连接池上限（默认 20）
# 必须 ≥ MAX_CONCURRENT × EMBED_CONCURRENCY，否则会 PoolTimeout
# PIPELINE_EMBED_MAX_CONNECTIONS=20

# ===== 部署相关 =====
FRONTEND_PORT=8888
BACKEND_PORT=8088

# ===== 认证与授权（tenant-auth）=====
# 鉴权总开关（灰度阀）。联调阶段可设 false 旁路鉴权分步验证，正式环境必须 true。
AUTH_ENABLED=true
# JWT 签名密钥（HS256）。auth_enabled=true 时为必填，缺失则服务启动失败（fail-fast）。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT 有效期（分钟），默认 720（12 小时）
JWT_EXPIRE_MINUTES=720
# 初始超级管理员（首次启动引导创建，强制首次登录改密）。必填，禁止用默认口令。
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# 注册模式：invite_only（默认，仅管理员建号）| self_serve（开放自助注册）
REGISTRATION_MODE=invite_only
# 超管业务内容可见边界：false（默认）= 超管不可查看业务内容正文
CONTENT_VIEW_BOUNDARY_OPEN=false
