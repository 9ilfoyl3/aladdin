# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aladdin
# POSTGRES_PASSWORD=postgres

# ===== Milvus 向量数据库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Redis（检索缓存，不配置则禁用） =====
# REDIS_URL=redis://localhost:6379/0
# RETRIEVAL_CACHE_TTL=1800

# ===== LLM 配置 =====
# provider: ollama | vllm
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# ===== Embedding 模型 =====
# provider: sentence-transformers | flag-embedding | remote
#   sentence-transformers: 跨平台，推荐 Windows 本地开发
#   flag-embedding: 支持稀疏向量，推荐 Linux/macOS 生产
#   remote: 调用外部 API（需配置 EMBED_BASE_URL）
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
EMBED_BASE_URL=
EMBED_API_KEY=

# ===== Rerank 模型 =====
# provider: sentence-transformers | flag-embedding | remote
RERANK_PROVIDER=sentence-transformers
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_BASE_URL=
RERANK_API_KEY=

# ===== 模型目录（挂载模型模式） =====
# MODEL_DIR=/opt/models

# ===== 远程 Embedding/Rerank 示例 =====
# EMBED_PROVIDER=remote
# EMBED_BASE_URL=http://10.30.1.4:8902/v1
# EMBED_MODEL=Qwen3-Embedding-0.6B
# EMBED_API_KEY=your-token-here
#
# RERANK_PROVIDER=remote
# RERANK_BASE_URL=http://10.30.1.3:8001/ranking_score
# RERANK_MODEL=
# RERANK_API_KEY=

# ===== Agent 参数 =====
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30.0

# ===== 切片参数 =====
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ===== OCR 配置 =====
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=external_api
OCR_PADDLEOCR_LANG=ch
OCR_PADDLEOCR_USE_GPU=false
OCR_EXTERNAL_API_URL=http://ocr-service:8080/recognize
OCR_EXTERNAL_API_KEY=
OCR_EXTERNAL_API_TIMEOUT=30

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== Pipeline Worker 配置 =====
PIPELINE_MAX_CONCURRENT=3
PIPELINE_MAX_RETRIES=3
PIPELINE_SLOW_THRESHOLD_MS=30000
# 单个文档处理总超时（分钟），超时直接标记失败
# PIPELINE_TASK_TIMEOUT_MINUTES=30
# 连续失败 N 次触发熔断，暂停消费队列
# PIPELINE_CIRCUIT_BREAKER_THRESHOLD=5
# 健康检查/熔断恢复轮询间隔（秒）
# PIPELINE_HEALTH_CHECK_INTERVAL=30

# ===== 前端配置（通过 /api/system/frontend-config 下发） =====
# 前端并发上传文件数
# UPLOAD_MAX_CONCURRENT=3
# 单文件最大上传大小（MB），需与 nginx client_max_body_size 一致
# UPLOAD_MAX_FILE_SIZE_MB=500

# ===== Docker 镜像配置（生产部署用，docker-compose 引用） =====
# 不配置时使用 docker-compose.yml 中的默认值（原始镜像名）
# ===== Docker 镜像配置（生产部署用） =====
# 不配置时使用 docker-compose.yml 中的默认值
# 配置后可指向公司镜像库，按架构区分标签
#
# AMD64 示例：
# IMAGE_POSTGRES=registry.company.com/aladdin/postgres:16-alpine-amd64
# IMAGE_MILVUS=registry.company.com/aladdin/milvus:v2.4.6-amd64
# IMAGE_ETCD=registry.company.com/aladdin/etcd:v3.5.25-amd64
# IMAGE_MINIO=registry.company.com/aladdin/minio:2024-05-28-amd64
# IMAGE_BACKEND=registry.company.com/aladdin/aladdin-backend:latest-amd64
# IMAGE_FRONTEND=registry.company.com/aladdin/aladdin-frontend:latest-amd64
#
# ARM64 示例：
# IMAGE_POSTGRES=registry.company.com/aladdin/postgres:16-alpine-arm64
# IMAGE_MILVUS=registry.company.com/aladdin/milvus:v2.4.6-arm64
# IMAGE_ETCD=registry.company.com/aladdin/etcd:v3.5.25-arm64
# IMAGE_MINIO=registry.company.com/aladdin/minio:2024-05-28-arm64
# IMAGE_BACKEND=registry.company.com/aladdin/aladdin-backend:latest-arm64
# IMAGE_FRONTEND=registry.company.com/aladdin/aladdin-frontend:latest-arm64

# ===== 前端端口 =====
# FRONTEND_PORT=8888
