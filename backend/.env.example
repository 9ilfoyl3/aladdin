# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aladdin

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LLM 配置（ollama | vllm）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Embedding 模型
# EMBED_PROVIDER: sentence-transformers（跨平台，推荐本地开发） | flag-embedding（支持稀疏向量，Windows 兼容性差）
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# Rerank 模型
# RERANK_PROVIDER: sentence-transformers（跨平台，推荐） | flag-embedding（FlagReranker，Windows 兼容性差）
RERANK_PROVIDER=sentence-transformers
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# Agent 参数
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30.0

# 切片参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ===== OCR 配置 =====
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=external_api

# PaddleOCR
OCR_PADDLEOCR_LANG=ch
OCR_PADDLEOCR_USE_GPU=false

# 外部 OCR API
OCR_EXTERNAL_API_URL=http://ocr-service:8080/recognize
OCR_EXTERNAL_API_KEY=
OCR_EXTERNAL_API_TIMEOUT=30
