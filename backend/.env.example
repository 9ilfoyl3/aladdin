# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite:///data/rag.db

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LLM 配置（ollama | vllm）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Embedding 模型
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cuda

# Rerank 模型
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda

# Agent 参数
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30.0

# 切片参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ===== OCR 配置 =====
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=external_api

# PaddleOCR
OCR_PADDLEOCR_LANG=ch
OCR_PADDLEOCR_USE_GPU=false

# 外部 OCR API
OCR_EXTERNAL_API_URL=http://ocr-service:8080/recognize
OCR_EXTERNAL_API_KEY=
OCR_EXTERNAL_API_TIMEOUT=30
