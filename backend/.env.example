# ============================================================
# Aladdin 配置文件示例
# 复制为 .env 后按需修改，注释项使用默认值即可
# ============================================================

# ===== 基础设施 =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aladdin
MILVUS_HOST=localhost
MILVUS_PORT=19530
REDIS_URL=redis://localhost:6379/0

# ===== Embedding（必填，选一种模式） =====
# 远程模式（推荐生产环境）：
EMBED_PROVIDER=remote
EMBED_BASE_URL=http://your-embedding-server/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=

# 使用内置 Infinity 服务（docker-compose 中的 infinity 容器）：
# EMBED_BASE_URL=http://infinity:7997
# EMBED_MODEL=/models/bge-m3

# 本地模式（开发环境）：
# EMBED_PROVIDER=sentence-transformers
# EMBED_MODEL=BAAI/bge-m3
# EMBED_DEVICE=cpu

# ===== Rerank（必填，选一种模式） =====
# 远程模式：
RERANK_PROVIDER=remote
RERANK_BASE_URL=http://your-rerank-server/ranking_score
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# 使用内置 Infinity 服务：
# RERANK_BASE_URL=http://infinity:7997
# RERANK_MODEL=/models/bge-reranker-v2-m3

# ===== LLM =====
# 也可启动后在前端"模型管理"页面配置
LLM_PROVIDER=vllm
LLM_BASE_URL=http://your-llm-server/v1
LLM_MODEL=your-model
LLM_API_KEY=

# ===== Pipeline Worker =====
# 通常不需要改，使用默认值即可
# PIPELINE_MAX_CONCURRENT=3          # Worker 并发处理文档数
# PIPELINE_EMBED_CONCURRENCY=8       # Embedding 并发请求数（远程慢时降为 2-3）
# PIPELINE_TASK_TIMEOUT_MINUTES=60   # 单文档处理超时（分钟）
# PIPELINE_CIRCUIT_BREAKER_THRESHOLD=5  # 连续失败 N 次触发熔断

# ===== 切片参数 =====
# PARENT_CHUNK_SIZE=1500
# CHILD_CHUNK_SIZE=300
# CHUNK_OVERLAP=50

# ===== Agent 参数 =====
# AGENT_MAX_ITERATIONS=3
# AGENT_TIMEOUT=30.0

# ===== 部署相关（可选） =====
# POSTGRES_PASSWORD=postgres
# FRONTEND_PORT=8888
# WORKER_REPLICAS=1
