# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aladdin

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LLM 配置（ollama | vllm）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Embedding 模型
# EMBED_PROVIDER: sentence-transformers | flag-embedding | remote
# - sentence-transformers: 跨平台，推荐本地开发
# - flag-embedding: 支持稀疏向量，生产推荐
# - remote: 调用外部 Embedding API（需配置 EMBED_BASE_URL）
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
# remote provider 使用（OpenAI 兼容接口填到 /v1，自定义接口填完整端点）：
EMBED_BASE_URL=
EMBED_API_KEY=

# Rerank 模型
# RERANK_PROVIDER: sentence-transformers | flag-embedding | remote
# - sentence-transformers: 跨平台，推荐本地开发
# - flag-embedding: 支持稀疏向量，生产推荐
# - remote: 调用外部 Rerank API（需配置 RERANK_BASE_URL）
RERANK_PROVIDER=sentence-transformers
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
# remote provider 使用（标准接口填到 /v1，自定义接口填完整端点如 /ranking_score）：
RERANK_BASE_URL=
RERANK_API_KEY=

# ===== 远程 Embedding/Rerank 示例配置 =====
# 如果部署时默认使用远程服务，取消下面的注释并填入实际地址：
#
# EMBED_PROVIDER=remote
# EMBED_BASE_URL=http://10.30.1.4:8902/v1
# EMBED_MODEL=Qwen3-Embedding-0.6B
# EMBED_API_KEY=your-token-here
#
# RERANK_PROVIDER=remote
# RERANK_BASE_URL=http://10.30.1.3:8001/ranking_score
# RERANK_MODEL=
# RERANK_API_KEY=

# Agent 参数
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30.0

# 切片参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ===== OCR 配置 =====
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=external_api

# PaddleOCR
OCR_PADDLEOCR_LANG=ch
OCR_PADDLEOCR_USE_GPU=false

# 外部 OCR API
OCR_EXTERNAL_API_URL=http://ocr-service:8080/recognize
OCR_EXTERNAL_API_KEY=
OCR_EXTERNAL_API_TIMEOUT=30
