# ============================================================
# Aladdin 生产环境配置（内网服务器 + GPU）
# ============================================================

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库（Docker 内部通信，不需要改）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aladdin

# Milvus（Docker 内部通信，不需要改）
MILVUS_HOST=milvus
MILVUS_PORT=19530

# LLM 配置（启动后在前端"模型管理"中配置，这里留空）
LLM_PROVIDER=vllm
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Embedding 模型（GPU 加速）
EMBED_PROVIDER=flag-embedding
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cuda

# Rerank 模型（GPU 加速）
RERANK_PROVIDER=flag-embedding
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda

# Agent 参数
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT=30.0

# 切片参数
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50

# OCR 配置
OCR_ENABLED=true
OCR_PROVIDER=external_api
OCR_EXTERNAL_API_URL=http://10.30.1.2:8909/parse
OCR_EXTERNAL_API_KEY=
OCR_EXTERNAL_API_TIMEOUT=300
